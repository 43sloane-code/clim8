# Python bytecode
__pycache__/
*.py[cod]

# Generated SQLite verdict store (runtime state, not source)
*.db

# Local HTTP response cache (runtime state, not source)
.cache/

# Local agent/editor config
.claude/

# launchd / server runtime logs (transient, not source)
reports/launchd.out.log
reports/launchd.err.log
reports/server.log

# Daily-generated health-check reports (reproducible output, not source).
# reports/baseline.json is the committed reference and stays tracked.
reports/healthcheck_*.txt
reports/latest.txt
