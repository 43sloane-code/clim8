# Python bytecode
__pycache__/
*.py[cod]

# Generated SQLite verdict store (runtime state, not source)
*.db

# Local HTTP response cache (runtime state, not source)
.cache/

# Local agent/editor config
.claude/

# launchd / server runtime logs (transient, not source)
reports/launchd.out.log
reports/launchd.err.log
reports/server.log

# Generated text reports under reports/ (health checks, live probes, latest.txt)
# are reproducible output, not source. reports/baseline.json is the committed
# reference the health check grades against and stays tracked (it is .json).
reports/*.txt
